rust_library {
    name: "libpushcompat_listener",
    crate_name: "pushcompat_listener",
    cargo_env_compat: true,
    cargo_pkg_version: "0.1.0",
    crate_root: "crates/listener/src/lib.rs",
    edition: "2024",
    rustlibs: [
        "libaes_gcm",
        "libbytes",
        "libdata_encoding",
        "libflate2",
        "libhkdf",
        "libp256",
        "libpin_project_lite",
        "libquick_protobuf",
        "librand-0.8",
        "libreqwest_ring",
        "librustls_ring",
        "libserde",
        "libserde_json",
        "libsha2",
        "libtokio",
        "libtokio_rustls_ring",
        "libtokio_stream",
        "libtracing",
        "liburlencoding",
        "libwebpki_roots",
    ],
    min_sdk_version: "29",
}

rust_ffi_shared {
    name: "libpushcompat_jni",
    crate_name: "pushcompat_jni",
    cargo_env_compat: true,
    cargo_pkg_version: "0.1.0",
    crate_root: "crates/jni/src/lib.rs",
    edition: "2024",
    prefer_rlib: true,
    rustlibs: [
        "libjni",
        "libpushcompat_listener",
        "libreqwest_ring",
        "libserde",
        "libserde_json",
        "libtokio",
        "libtokio_stream",
    ],
    min_sdk_version: "29",
}
